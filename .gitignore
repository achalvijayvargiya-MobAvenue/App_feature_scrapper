#
# Minimal, runnable repo whitelist
# --------------------------------
# Goal: keep only code required to run the android/ and ios/ pipelines.
#
# Everything else (CSV/XLSX datasets, notebooks, logs, reports, etc.)
# will be ignored by default.
#

.DS_Store
__pycache__/

# README.md and RUNBOOK.md are tracked project documentation.

!.gitignore
!requirements.txt
!fill_invalid_generic.py
!run_pipeline.py
!combine.py
!config.yaml
!pipeline/
!pipeline/**/*.py
!android/
!android/**/*.py
!ios/
!ios/**/*.py
